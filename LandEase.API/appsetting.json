{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your_Database_Connection_String_Here",
    "AzureStorage": "Your_Azure_Storage_Connection_String_Here"
  },
