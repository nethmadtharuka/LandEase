{
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_HERE",
    "Issuer": "LandEaseAPI",
    "Audience": "LandEaseClient",
    "ExpiryMinutes": "60"
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DB_CONNECTION_STRING_HERE"
  },
  "AzureStorage": {
    "ConnectionString": "YOUR_AZURE_STORAGE_CONNECTION_STRING_HERE",
    "ContainerName": "kyc-documents"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "SenderEmail": "YOUR_EMAIL_HERE",
    "SenderName": "LandEase",
    "Password": "YOUR_GMAIL_APP_PASSWORD_HERE"
  },
  "GeminiApi": {
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE",
    "Model": "gemini-2.0-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models"
  },
  "RateLimiting": {
    "AiEndpointsPerMinute": "10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
